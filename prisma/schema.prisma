// Hilo — modelo de datos
//
// Principios:
//  1. Un `Item` unificado modela los seis tipos de contenido (tarea, idea, nota,
//     problema, decision, actualizacion). Comentarios, adjuntos, actividad,
//     menciones y busqueda apuntan a una sola superficie en vez de seis.
//  2. `Project` es auto-referencial: un subproyecto ES un proyecto. Se guarda un
//     `path` materializado para resolver subarboles en una sola query.
//  3. La actividad se escribe una vez (`Activity`) y se reparte a los usuarios
//     relevantes (`FeedEntry`). Eso hace que el feed personalizado y los
//     no-leidos sean baratos en lectura por usuario en lugar de recalcularse.
//  4. Sin enums nativos: strings validados en el dominio (src/lib/domain.ts).
//     Permite agregar estados/roles sin migracion y mantiene el schema portable
//     entre SQLite (dev) y PostgreSQL (produccion).
//  5. Una instancia = un equipo (`Team`). No hay multitenancy: `Team` reutiliza
//     el id del workspace historico (las claves de storage y los ApiToken no
//     cambian) y `Membership` es global (`@@unique([userId])`).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------------- identidad

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  avatarUrl    String?
  accentColor  String   @default("clay")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions        Session[]
  apiTokens       ApiToken[]
  memberships     Membership[]
  projectSeats    ProjectMember[]
  createdItems    Item[]              @relation("ItemAuthor")
  assignments     ItemAssignment[]    @relation("AssignmentUser")
  assignedByMe    ItemAssignment[]    @relation("AssignmentActor")
  comments        Comment[]
  mentions        Mention[]
  attachments     Attachment[]
  activities      Activity[]
  feed            FeedEntry[]
  createdProjects Project[]           @relation("ProjectAuthor")
  proposals       Proposal[]
  proposalReplies ProposalReply[]
  knowledge       KnowledgeResource[]
  editedDocs      ProjectDoc[]        @relation("ProjectDocEditor")
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Token de acceso API para clientes MCP. `id` es el hash sha256 del token
/// crudo (mismo patrón que Session: el valor viajero nunca se persiste).
/// No guarda teamId: con un solo equipo por instancia, el token + la
/// membership global resuelven el contexto.
model ApiToken {
  id        String   @id
  userId    String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------- el equipo

/// El único equipo de la instancia. `id` es el id del workspace histórico:
/// las claves de storage (`<teamId>/<hash>`) y los ApiToken conservan su
/// valor sin ninguna migración de datos extra.
model Team {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  mission   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// role: "admin" | "developer" | "community".
/// Una fila por usuario: el rol aplica a todo el equipo.
model Membership {
  id         String   @id @default(cuid())
  userId     String
  role       String   @default("community")
  title      String?
  joinedAt   DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([role])
}

// --------------------------------------------------------------- proyectos

/// Un subproyecto es un Project con `parentId`. Misma estructura, misma UI.
/// `path` es la ruta materializada de ancestros ("/rootId/parentId/") para
/// consultar un subarbol completo con un solo startsWith.
model Project {
  id        String  @id @default(cuid())
  parentId  String?
  path      String  @default("/")
  depth     Int     @default(0)

  name        String
  description String?
  coverUrl    String?
  accent      String  @default("clay")

  /// Encuadre de la portada: qué punto de la imagen queda en el centro del
  /// recorte (0-100 en cada eje) y cuánto se acerca (100 = sin acercar). Se
  /// guarda el encuadre, no un recorte: la imagen original queda intacta y el
  /// mismo punto sirve para la franja del proyecto y para la tarjeta, que
  /// tienen proporciones distintas.
  coverX    Int @default(50)
  coverY    Int @default(50)
  coverZoom Int @default(100)

  /// "active" | "paused" | "done" | "cancelled"
  status String @default("active")

  /// "low" | "medium" | "high" | "urgent"
  priority String @default("medium")

  startDate   DateTime?
  targetDate  DateTime?
  completedAt DateTime?
  archivedAt  DateTime?

  /// "auto" (derivado de tareas y subproyectos) | "manual"
  progressMode String @default("auto")
  progress     Int    @default(0)

  position    Float    @default(0)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent    Project?  @relation("ProjectTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Project[] @relation("ProjectTree")
  createdBy User      @relation("ProjectAuthor", fields: [createdById], references: [id])

  members           ProjectMember[]
  items             Item[]
  comments          Comment[]
  attachments       Attachment[]
  activities        Activity[]
  proposals         Proposal[]          @relation("ProposalTarget")
  promotedProposals Proposal[]          @relation("ProposalPromotion")
  knowledge         KnowledgeResource[]
  doc               ProjectDoc?

  @@index([status, archivedAt])
  @@index([parentId])
  @@index([path])
}

/// Documento de contexto del proyecto: el "leeme".
///
/// Vive en su propia tabla y no como una columna de Project a proposito: asi no
/// puede colarse en projectCardSelect ni en ningun select de listado. El
/// markdown puede traer bloques marcados como solo-equipo, y solo se lee
/// pasando por src/server/domain/doc.ts, que decide que parte devuelve.
model ProjectDoc {
  id          String   @id @default(cuid())
  projectId   String   @unique
  markdown    String   @default("")
  updatedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  updatedBy User    @relation("ProjectDocEditor", fields: [updatedById], references: [id])
}

/// role: "lead" | "contributor"
model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("contributor")
  addedAt   DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

// --------------------------------------------------------------- contenido

/// Seis tipos, una tabla. `type` decide que campos se muestran y que estados
/// son validos; el resto (comentarios, adjuntos, actividad) es comun.
model Item {
  id        String  @id @default(cuid())
  projectId String
  /// Subtareas: un Item hijo de otro Item.
  parentId  String?

  /// "task" | "idea" | "note" | "problem" | "decision" | "update"
  type  String
  title String
  body  String?

  /// Conjunto de valores segun `type` (ver src/lib/domain.ts)
  status String @default("todo")

  /// "low" | "medium" | "high" | "urgent"
  priority String    @default("medium")
  dueDate  DateTime?

  /// "individual" (usa ItemAssignment) | "team" (todo el equipo)
  assigneeScope String @default("individual")

  /// "auto" (derivado de subtareas / estado) | "manual"
  progressMode String @default("auto")
  progress     Int    @default(0)

  position    Float     @default(0)
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  /// Trazabilidad cuando una idea se convierte en tarea.
  convertedFromId String?

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent      Item?            @relation("ItemTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Item[]           @relation("ItemTree")
  createdBy   User             @relation("ItemAuthor", fields: [createdById], references: [id])
  assignments ItemAssignment[]
  comments    Comment[]
  attachments Attachment[]
  mentions    Mention[]
  activities  Activity[]

  @@index([projectId, type, status])
  @@index([type, status])
  @@index([parentId])
  @@index([dueDate])
}

/// `weight` = porcentaje de colaboracion de esa persona en la tarea (0-100).
/// El dominio reparte y normaliza para que la suma sea 100.
model ItemAssignment {
  id           String   @id @default(cuid())
  itemId       String
  userId       String
  weight       Int      @default(100)
  assignedById String
  assignedAt   DateTime @default(now())

  item       Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user       User @relation("AssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User @relation("AssignmentActor", fields: [assignedById], references: [id])

  @@unique([itemId, userId])
  @@index([userId])
}

// ----------------------------------------------------- comentarios y menciones

model Comment {
  id        String    @id @default(cuid())
  authorId  String
  /// Un comentario cuelga de un Item o de un Project (nunca de ambos).
  itemId    String?
  projectId String?
  body      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  editedAt  DateTime?

  author    User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  item      Item?        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  project   Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mentions  Mention[]
  attachments Attachment[]

  @@index([itemId, createdAt])
  @@index([projectId, createdAt])
}

model Mention {
  id        String   @id @default(cuid())
  userId    String
  commentId String?
  itemId    String?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  item    Item?    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ------------------------------------------------------- archivos y recursos

model Attachment {
  id          String @id @default(cuid())
  uploaderId  String

  filename   String
  mimeType   String
  sizeBytes  Int
  storageKey String

  /// "image" | "file"
  kind   String @default("file")
  width  Int?
  height Int?

  projectId  String?
  itemId     String?
  commentId  String?
  /// Cuando el archivo es la captura de un recurso de conocimiento (screenshot
  /// del sitio, del panel, etc.), en vez de ir colgado de un proyecto o tarea.
  resourceId String?
  createdAt  DateTime @default(now())

  uploader User               @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  project  Project?           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  item     Item?              @relation(fields: [itemId], references: [id], onDelete: Cascade)
  comment  Comment?           @relation(fields: [commentId], references: [id], onDelete: Cascade)
  resource KnowledgeResource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([itemId])
  @@index([kind])
  @@index([resourceId])
}

// ------------------------------------------------ propuestas de la comunidad

/// Entrada liviana al trabajo del equipo. Una propuesta puede conversarse,
/// vincularse a un proyecto existente o convertirse en un proyecto nuevo.
model Proposal {
  id        String @id @default(cuid())
  authorId  String
  title     String
  body      String
  category  String @default("project")
  status    String @default("proposed")

  targetProjectId   String?
  promotedProjectId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  author          User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  targetProject   Project?        @relation("ProposalTarget", fields: [targetProjectId], references: [id], onDelete: SetNull)
  promotedProject Project?        @relation("ProposalPromotion", fields: [promotedProjectId], references: [id], onDelete: SetNull)
  replies         ProposalReply[]

  @@index([status, createdAt])
  @@index([targetProjectId])
}

model ProposalReply {
  id         String   @id @default(cuid())
  proposalId String
  authorId   String
  body       String
  createdAt  DateTime @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([proposalId, createdAt])
}

// -------------------------------------------- recursos e interoperabilidad

/// Recurso compartido de la red. Puede pertenecer a todo el equipo o a un
/// proyecto. Las guías API aceptan Markdown pegado o una fuente remota.
model KnowledgeResource {
  id          String  @id @default(cuid())
  projectId   String?
  addedById   String

  name        String
  summary     String?
  kind        String  @default("link")
  url         String?
  accessGuide String?
  markdown    String?
  markdownUrl String?

  /// Orden dentro de un proyecto, igual que `ResourceLink.position` antes de
  /// unificarse acá: lo que se pegó primero queda primero.
  position  Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project     Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  addedBy     User         @relation(fields: [addedById], references: [id])
  attachments Attachment[]

  @@index([kind])
  @@index([projectId, kind])
}

// ----------------------------------------------------------- actividad y feed

/// Evento inmutable. `targetLabel` se desnormaliza para que el historial siga
/// siendo legible aunque el elemento original se renombre o se borre.
model Activity {
  id      String @id @default(cuid())
  actorId String

  /// ver ACTIVITY en src/lib/domain.ts (p. ej. "item.status_changed")
  verb String

  projectId String?
  itemId    String?

  targetType  String
  targetId    String
  targetLabel String

  /// JSON serializado con el detalle del cambio (from/to, valores, etc.)
  meta      String?
  createdAt DateTime @default(now())

  actor   User        @relation(fields: [actorId], references: [id], onDelete: Cascade)
  project Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  item    Item?       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  entries FeedEntry[]

  @@index([createdAt])
  @@index([projectId, createdAt])
  @@index([itemId, createdAt])
}

/// Fan-out en escritura: una fila por (usuario, evento relevante).
/// `reason` explica por que le llega y `direct` marca si es notificacion.
model FeedEntry {
  id         String @id @default(cuid())
  userId     String
  activityId String

  /// "assigned" | "mentioned" | "reply" | "author" | "participant"
  reason    String
  direct    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([userId, activityId])
  @@index([userId, createdAt])
  @@index([userId, readAt])
}